{
  // Host face: the Node plugin half (the /sidebar JSON API, git/pty/ws) plus
  // the non-React client modules the host side and its host-rate specs import
  // (the state/service registry, pure view helpers, prefs). It extends the
  // client base purely for the DOM lib + React JSX those modules need
  // (state.ts / breakpoints.ts read window; the public service types are
  // React-typed); the host code itself is node, so `types` stays ["node"].
  //
  // Only host-safe references here. The api/connection client faces and the
  // ui-settings/ui-primitives/ui-slots client packages are the Client
  // aggregate's concern (they reach the generated `/remote` artifacts) and
  // live in tsconfig.client.json. No source here imports them.
  "extends": "../../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.host.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    // All top-level src/*.ts (host half) plus all non-React client .ts
    // modules. React components (*.tsx) are the Client face and stay out:
    // several import ui-settings etc., which reaches /remote.
    "src/**/*.ts"
  ],
  "exclude": [
    // The one client .ts that re-exports React components (builtins/index.ts
    // imports builtins/tabs.tsx + viewers.tsx); it is only used by the
    // Client aggregate (tests/builtins.client.spec.ts).
    "src/client/builtins/index.ts"
  ],
  "references": [
    { "path": "../../../vendor/cordis" },
    { "path": "../../../vendor/schemastery" },
    { "path": "../../core/session" },
    { "path": "../../core/agent" },
    { "path": "../../core/tools" },
    { "path": "../../llm/llm" },
    { "path": "../../settings/settings" },
    { "path": "../../subagent/subagent" },
    { "path": "../../subprocess/subprocess-local" },
    { "path": "../../terminal/terminal-bash" }
  ]
}
