{
  // Client face: the full package source (host half + browser half) so the
  // Client aggregate can compile every one of this package's tests, including
  // those that reach into the host half (e.g. git.client.spec.ts). It keeps
  // every reference the single config had (api client faces, ui-*, core/...),
  // so it must only be built by the Client aggregate — at
  // `typecheck:contracts-ready` the api packages' generated `/remote`
  // artifacts already exist. It is not in the host graph; the host faces
  // toward tsconfig.host.json, which references host-safe packages only.
  "extends": "../../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "lib/tsconfig.client.tsbuildinfo"
  },
  "include": [
    "src"
  ],
  "references": [
    { "path": "../../../vendor/cordis" },
    { "path": "../../../vendor/schemastery" },
    { "path": "../../api/remotes/tsconfig.client.json" },
    { "path": "../../api/session-controller/tsconfig.client.json" },
    { "path": "../../api/workspace-controller/tsconfig.client.json" },
    { "path": "../../core/agent" },
    { "path": "../../core/session" },
    { "path": "../../core/tools" },
    { "path": "../../llm/llm" },
    { "path": "../../settings/settings" },
    { "path": "../../subagent/subagent" },
    { "path": "../connection/tsconfig.client.json" },
    { "path": "../ui-primitives" },
    { "path": "../ui-settings" },
    { "path": "../ui-slots" }
  ]
}
